PORT=5000
# MongoDB Atlas connection string (free M0 cluster works)
CONNECTION_URL=mongodb+srv://<user>:<password>@<cluster>/quizapp
# Optional: secret for the admin-only POST /api/v1/questions/create/* routes
ADMIN_KEY=
# Optional: comma-separated front-end origins allowed by CORS (empty = all)
CORS_ORIGINS=https://saravanan-22.github.io,http://localhost:3000
